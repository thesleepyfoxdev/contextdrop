
# Application
APP_NAME=contextdrop
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/contextdrop.db

# Storage (minio, filesystem)
STORAGE_PROVIDER=filesystem
FILESYSTEM_ROOT=./data/files

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contextdrop
MINIO_SECURE=false

# File settings
MAX_FILE_SIZE_MB=1024
